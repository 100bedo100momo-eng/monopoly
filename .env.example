# ===== Supabase (Project Settings → API) =====
# انسخ هذا الملف إلى .env.local ثم ضع قيم مشروعك
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# ملاحظة: لا تضع Service Role Key هنا إطلاقًا — المفتاح العام (anon) فقط للواجهة،
# وكل العمليات الحساسة محمية بدوال SQL + RLS على السيرفر.

# ===== اختياري لاختبارات E2E مع Supabase محلي =====
# E2E_SUPABASE_URL=http://127.0.0.1:54321
# E2E_SUPABASE_ANON_KEY=your-local-anon-key
# E2E_BASE_URL=http://localhost:3000
